<article class="post article">
  <%- partial('_partial/post-header', {post: page}) %>
  <% if (theme.toc && page.toc !== false){ %>
    <aside class="toc" id="toc">
      <%- partial('_partial/toc', {post: page}) %>
    </aside>
  <% } %>
  <div class="post-content">
    <%- page.content %>
  </div>
  <%- partial('_partial/post-footer', {post: page}) %>
</article>
