<header class="post-header">
  <h1 class="post-title"><%= post.title %></h1>
  <div class="post-meta">
    <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, theme.date_format || 'YYYY-MM-DD') %></time>
    <% if (post.categories && post.categories.length){ %>
      <span class="post-meta-sep">&middot;</span>
      <% post.categories.forEach(function(cat){ %>
        <a href="<%- url_for(cat.path) %>" class="post-cat"><%= cat.name %></a>
      <% }) %>
    <% } %>
    <% if (post.tags && post.tags.length){ %>
      <span class="post-meta-sep">&middot;</span>
      <% post.tags.forEach(function(tag){ %>
        <a href="<%- url_for(tag.path) %>" class="post-tag">#<%= tag.name %></a>
      <% }) %>
    <% } %>
  </div>
</header>