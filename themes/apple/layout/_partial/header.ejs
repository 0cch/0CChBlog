<header class="header" id="header">
  <nav class="nav">
    <div class="nav-container">
      <a href="<%- url_for('/') %>" class="nav-brand">
        <span class="brand-text"><%= theme.brand || config.title %></span>
      </a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
      <div class="nav-menu" id="nav-menu">
        <% for (var name in theme.menu){ %>
          <a href="<%- url_for(theme.menu[name]) %>" class="nav-link"><%= name %></a>
        <% } %>
        <% if (theme.search){ %>
          <button class="nav-search-btn" id="search-btn" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </button>
        <% } %>
        <% if (theme.dark_mode){ %>
          <button class="nav-theme-btn" id="theme-btn" aria-label="Toggle theme">
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
        <% } %>
      </div>
    </div>
  </nav>
  <% if (theme.search){ %>
  <div class="search-overlay" id="search-overlay">
    <div class="search-box">
      <input type="text" id="search-input" placeholder="Search articles..." autocomplete="off">
      <div class="search-results" id="search-results"></div>
    </div>
    <button class="search-close" id="search-close">&times;</button>
  </div>
  <% } %>
</header>