<nav class="pagination">
  <% if (page.prev){ %>
    <a href="<%- url_for(page.prev_link) %>" class="page-prev">&larr; Prev</a>
  <% } %>
  <span class="page-numbers">
    <% for (var i = 1; i <= page.total; i++){ %>
      <% if (i === page.current){ %>
        <span class="page-current"><%= i %></span>
      <% } else if (i === 1){ %>
        <a href="<%- url_for(page.base) %>"><%= i %></a>
      <% } else { %>
        <a href="<%- url_for(page.base + 'page/' + i + '/') %>"><%= i %></a>
      <% } %>
    <% } %>
  </span>
  <% if (page.next){ %>
    <a href="<%- url_for(page.next_link) %>" class="page-next">Next &rarr;</a>
  <% } %>
</nav>